<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Cherry Move</string>
  <key>CFBundleDisplayName</key><string>Cherry Move</string>
  <key>CFBundleIdentifier</key><string>org.cherryos.move</string>
  <key>CFBundleExecutable</key><string>CherryMove</string>
  <key>CFBundleIconFile</key><string>CherryMove</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>CFBundlePackageType</key><string>APPL</string>
