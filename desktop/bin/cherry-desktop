#!/usr/bin/env python3
"""cherry-desktop — list and switch desktops.
  cherry-desktop list
  cherry-desktop current
  cherry-desktop switch ID              your next login uses this desktop (live session: switches now)
  cherry-desktop install ID             root: download a desktop that isn't on the ISO (Hyprland)
  cherry-desktop set-default ID [--root DIR] [--user NAME]
                                        root: the default for new users (and NAME's next login)
  cherry-desktop live-boot              root, live session only: apply cherry.desktop= from the boot menu
"""
import sys
from pathlib import Path

for lib in (Path(__file__).resolve().parent.parent / "lib", Path("/usr/lib/cherry")):
    if (lib / "cherryos").is_dir():
        sys.path.insert(0, str(lib))
        break

from cherryos import desktops as dk  # noqa: E402


def live_boot() -> int:
    """Runs before the login screen on the live system: start the desktop picked in the boot menu."""
    cmdline = Path("/proc/cmdline").read_text().split()
    choice = next((a.split("=", 1)[1] for a in cmdline if a.startswith("cherry.desktop=")), dk.default_desktop())
    if choice not in dk.DESKTOPS:
        choice = dk.default_desktop()
    dk.write_system_default(choice)
    dk.live_no_lock()
    dk.live_no_update_prompts()
    live_user = next((a.split("=", 1)[1] for a in cmdline if a.startswith("live-config.username=")), "cherry")
    dk.write_user_session(live_user, choice)
    dk.CHOICE_FILE.parent.mkdir(parents=True, exist_ok=True)
    dk.CHOICE_FILE.write_text(choice + "\n")
    if dk.INSTALLER_CHOOSER.exists():
        dk.INSTALLER_CHOOSER.write_text(dk.installer_default_text(dk.INSTALLER_CHOOSER.read_text(), choice))
    return 0


def main(argv):
    if not argv or argv[0] == "list":
        cur = dk.current_desktop()
        for d in dk.DESKTOPS.values():
            print(f"{'*' if d.id == cur else ' '} {d.id:9} {d.label:12} {d.tagline}")
        return 0
    cmd = argv[0]
    if cmd == "current":
        print(dk.current_desktop() or "unknown")
    elif cmd == "switch" and len(argv) > 1 and argv[1] in dk.DESKTOPS:
        if not dk.DESKTOPS[argv[1]].session():
            hint = f" Install it first: sudo cherry-desktop install {argv[1]}" if dk.DESKTOPS[argv[1]].on_demand else ""
            print(f"{dk.DESKTOPS[argv[1]].label} isn't installed.{hint}", file=sys.stderr)
            return 1
        if dk.is_live():
            dk.switch_live(argv[1])
        else:
            dk.set_user_session(argv[1])
            print(f"Log out and back in to start {dk.DESKTOPS[argv[1]].label}.")
    elif cmd == "install" and len(argv) > 1 and argv[1] in dk.DESKTOPS and dk.DESKTOPS[argv[1]].on_demand:
        return dk.install_desktop(argv[1])
    elif cmd == "set-default" and len(argv) > 1 and argv[1] in dk.DESKTOPS:
        root = Path(argv[argv.index("--root") + 1]) if "--root" in argv else Path("/")
        user = argv[argv.index("--user") + 1] if "--user" in argv else None
        dk.write_system_default(argv[1], root, user or None)
    elif cmd == "live-boot":
        return live_boot()
    else:
        print(__doc__)
        return 1
    return 0


sys.exit(main(sys.argv[1:]))
