#!/usr/bin/env python3
"""Cherry Center — welcome, desktops, files, Windows apps and updates.
  cherry-center [--page=welcome|desktop|files|store|windows|updates|about] [--welcome]
"""
import sys
from pathlib import Path

for lib in (Path(__file__).resolve().parent.parent / "lib", Path("/usr/lib/cherry")):
    if (lib / "cherryos").is_dir():
        sys.path.insert(0, str(lib))
        break

from cherryos.ui.center import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
